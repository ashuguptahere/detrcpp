#pragma once

#include <cstdint>

// Semantic version components (MAJOR.MINOR.PATCH).
#define DETR_VERSION_MAJOR @DETR_VERSION_MAJOR@
#define DETR_VERSION_MINOR @DETR_VERSION_MINOR@
