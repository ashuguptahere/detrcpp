#define DETR_VERSION_STRING "@DETR_VERSION@"

// Integer encoding: MAJOR * 10000 + MINOR * 100 + PATCH. Usable in #if checks,
// e.g.  #if DETR_VERSION_NUMBER >= 10200  // >= 1.2.0
#define DETR_VERSION_NUMBER \
  (DETR_VERSION_MAJOR * 10000 + DETR_VERSION_MINOR * 100 + DETR_VERSION_PATCH)

namespace detr {

